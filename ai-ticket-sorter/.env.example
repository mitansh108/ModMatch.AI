# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-me

# Inngest (optional — only needed if you re-enable the legacy Inngest path)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Mailtrap (or any SMTP)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# Gemini
GEMINI_API_KEY=

# App
APP_URL=http://localhost:3000

# Redis / BullMQ
# Local dev (Homebrew or Docker on default port):
REDIS_URL=redis://127.0.0.1:6379
# Hosted (Upstash example):
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Optional worker tuning (defaults shown)
# TICKET_WORKER_CONCURRENCY=5
# TICKET_RATE_LIMIT_MAX=10
# TICKET_RATE_LIMIT_DURATION_MS=60000
# RUN_WORKER_IN_API=true
